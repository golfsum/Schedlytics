{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "out",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://schedlytics-95655.firebaseapp.com/__/auth/:path*"
    },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/publish", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/weekly-brief", "schedule": "0 13 * * 1" }
  ]
}
