# Schedlytics frontend env — copy to ".env" to enable real connections.
#
# Point this at the backend (see /server). When set, the "Connect" buttons run
# real OAuth and the app pulls live stats. Leave it UNSET to use the built-in
# demo simulation (no backend required).
VITE_API_URL=http://localhost:8787

# Firebase Authentication (public client config from the Firebase console:
# Project settings > Your apps > SDK setup and configuration). Leave blank to
# disable login (open app, useful for local dev / demo).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=schedlytics-95655.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=schedlytics-95655
VITE_FIREBASE_STORAGE_BUCKET=schedlytics-95655.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
