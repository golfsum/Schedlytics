# ============================================================================
#  Schedlytics backend environment
#  Copy to ".env" and fill in the credentials from each developer console.
# ============================================================================

# This backend's public URL (must match the redirect URIs you register).
BASE_URL=http://localhost:8787
PORT=8787

# Where the React app runs (the user is sent back here after connecting).
FRONTEND_URL=http://localhost:5185

# Firebase project id - enables per-user settings sync (verifies the client's
# Firebase ID token server-side). The server also falls back to the frontend's
# VITE_FIREBASE_PROJECT_ID if this isn't set, so on Vercel you don't need a
# separate copy. Leave both blank to disable sync (data stays in the browser).
FIREBASE_PROJECT_ID=schedlytics-95655

# ---------------------------------------------------------------------------
# YouTube  →  https://console.cloud.google.com  (enable "YouTube Data API v3")
#   Redirect URI:  http://localhost:8787/auth/youtube/callback
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# TikTok  →  https://developers.tiktok.com  (Login Kit + Display API)
#   Redirect URI:  http://localhost:8787/auth/tiktok/callback
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Meta (Instagram + Facebook share ONE app)
#   →  https://developers.facebook.com  (Facebook Login + Instagram Graph API)
#   Redirect URIs:
#     http://localhost:8787/auth/facebook/callback
#     http://localhost:8787/auth/instagram/callback
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# Pinterest  →  https://developers.pinterest.com  (API v5)
#   Redirect URI:  http://localhost:8787/auth/pinterest/callback
# ---------------------------------------------------------------------------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ---------------------------------------------------------------------------
# Twitch  →  https://dev.twitch.tv/console/apps  (Helix API)
#   OAuth Redirect URL:  http://localhost:8787/auth/twitch/callback
# ---------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Patreon  →  https://www.patreon.com/portal/registration/register-clients  (API v2)
#   Redirect URI:  http://localhost:8787/auth/patreon/callback
# ---------------------------------------------------------------------------
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# ashrt.link  (URL shortener)  ->  see the ashrt.link repo
#   Set these to mint Schedlytics short links on your ashrt.link domain.
#   Leave blank to use the built-in shortener instead.
# ---------------------------------------------------------------------------
ASHRT_API_URL=https://ashrt.link
ASHRT_API_KEY=

# ---------------------------------------------------------------------------
# Anthropic (Claude)  ->  https://console.anthropic.com
#   Powers real AI titles/captions/hashtags in Media Studio. Leave blank to
#   use the built-in offline suggestion generator instead.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Scheduled publishing (Instagram/TikTok cron worker)
#   Vercel Cron calls /api/cron/publish on a schedule (see vercel.json) and
#   sends "Authorization: Bearer <CRON_SECRET>". Set the same value here so the
#   endpoint rejects anyone else. Requires Vercel KV/Upstash for the queue.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Weekly growth brief email (Monday cron -> /api/cron/weekly-brief)
#   SMTP for sending (e.g. Migadu: smtp.migadu.com, port 465). When unset, the
#   weekly email is a no-op (the in-app brief still works). SMTP_FROM defaults
#   to SMTP_USER.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Early access. EARLY_ACCESS=true (default) makes the marketing page show the
# sign-up form and hide app links; set EARLY_ACCESS=false for production. The
# app build also needs VITE_EARLY_ACCESS (true/false) for the "Early Access"
# badge. EARLY_ACCESS_CAP is the number of accepted spots before the waitlist.
# ---------------------------------------------------------------------------
EARLY_ACCESS=true
EARLY_ACCESS_CAP=25
# Where new-signup notifications go (defaults to SMTP_FROM/SMTP_USER). Requires SMTP.
ADMIN_EMAIL=
# Secret for GET /api/admin/early-access (list/export sign-ups). Locked when unset.
ADMIN_SECRET=
# Comma-separated emails allowed to open the in-app Admin page (verified via the
# user's Firebase ID token). Falls back to ADMIN_EMAIL if unset.
ADMIN_EMAILS=
# Firebase service account JSON (raw or base64) for the Admin "Users" tab:
# listing accounts + sending password resets. Firebase console -> Project
# Settings -> Service accounts -> Generate new private key. Without it, Early
# Access and Support still work; the Users tab shows a setup hint.
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated IPs to exclude from site analytics (e.g. your own address, so
# your visits don't inflate the Traffic tab). Find yours at https://ifconfig.me
ANALYTICS_EXCLUDE_IPS=
# Error alerts: email the owner (ADMIN_EMAIL) when a new error type appears or
# the same error happens this many times in an hour. Needs SMTP. Default 10.
ERROR_ALERT_THRESHOLD=10
